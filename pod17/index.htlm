<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>POD-17 · Ancient Ruins</title>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-R53MR0PS75"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-R53MR0PS75');
</script>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Segoe UI', Arial, sans-serif; background: #1a1a2e; color: #fff; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
#game-container { width: 100%; max-width: 480px; min-height: 100vh; display: flex; flex-direction: column; background: #16213e; position: relative; overflow: hidden; }
.screen { display: none; flex-direction: column; align-items: center; padding: 16px 16px 12px; flex: 1; }
.screen.active { display: flex; }
#hub-screen { background: linear-gradient(135deg,#1a1a2e,#16213e,#0f3460); }
.hub-badge { background: #7B5EA7; color: #fff; font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 20px; margin-bottom: 8px; letter-spacing: 1px; }
.hub-title { font-size: 26px; font-weight: 800; margin-bottom: 4px; text-align: center; }
.hub-subtitle { font-size: 13px; color: #a0aec0; margin-bottom: 20px; }
.word-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 24px; }
.word-chip { background: rgba(123,94,167,0.2); border: 1.5px solid #7B5EA7; color: #fff; border-radius: 20px; padding: 6px 14px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.word-chip:hover { background: rgba(123,94,167,0.45); }
.levels-title { font-size: 13px; font-weight: 700; color: #a0aec0; text-transform: uppercase; letter-spacing: 1px; align-self: flex-start; margin-bottom: 10px; }
.level-card { width: 100%; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.12); border-radius: 16px; padding: 16px 18px; margin-bottom: 12px; display: flex; align-items: center; gap: 14px; cursor: pointer; transition: all 0.2s; position: relative; }
.level-card:hover:not(.locked) { background: rgba(255,255,255,0.1); border-color: #BDA8D3; transform: translateY(-1px); }
.level-card.locked { opacity: 0.45; cursor: not-allowed; }
.level-card.completed { border-color: #38a169; }
.level-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
.level-icon.lv1 { background: linear-gradient(135deg,#7B5EA7,#3C3489); }
.level-icon.lv2 { background: linear-gradient(135deg,#9B77C7,#5C4499); }
.level-icon.lv3 { background: linear-gradient(135deg,#BDA8D3,#7B5EA7); }
.level-info { flex: 1; }
.level-name { font-size: 15px; font-weight: 700; margin-bottom: 2px; }
.level-desc { font-size: 12px; color: #a0aec0; }
.level-arrow { font-size: 18px; color: #a0aec0; }
.lock-icon { position: absolute; right: 16px; font-size: 18px; }
.level-header { width: 100%; display: flex; align-items: center; gap: 10px; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); }
.back-btn { background: rgba(255,255,255,0.08); border: none; color: #fff; width: 36px; height: 36px; border-radius: 10px; font-size: 18px; cursor: pointer; flex-shrink: 0; }
.level-header-info { flex: 1; }
.level-header-title { font-size: 15px; font-weight: 700; }
.level-header-sub { font-size: 11px; color: #a0aec0; }
.score-badge { background: #7B5EA7; color: #fff; font-size: 13px; font-weight: 700; padding: 4px 11px; border-radius: 20px; }
.progress-bar-wrap { width: 100%; height: 5px; background: rgba(255,255,255,0.1); border-radius: 3px; margin-bottom: 12px; }
.progress-bar-fill { height: 100%; background: linear-gradient(90deg,#7B5EA7,#3C3489); border-radius: 3px; transition: width 0.4s; }
.play-word-btn { border: none; color: #fff; border-radius: 50%; width: 56px; height: 56px; font-size: 22px; cursor: pointer; margin-bottom: 4px; transition: transform 0.15s; flex-shrink: 0; }
.play-word-btn:hover:not(:disabled) { transform: scale(1.08); }
.play-word-btn:active:not(:disabled) { transform: scale(0.95); }
.play-word-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.listen-label { font-size: 12px; color: #a0aec0; margin-bottom: 10px; }
.img-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.img-choice-card { border-radius: 14px; overflow: hidden; border: 2.5px solid rgba(255,255,255,0.1); cursor: pointer; transition: border-color 0.2s, transform 0.2s; background: #1e2a45; }
.img-choice-card img { width: 100%; display: block; object-fit: contain; background: #1e2a45; }
.img-choice-card:hover { border-color: #BDA8D3; transform: scale(1.02); }
.img-choice-card.correct { border-color: #38a169; box-shadow: 0 0 0 3px rgba(56,161,105,0.35); }
.img-choice-card.wrong   { border-color: #e53e3e; box-shadow: 0 0 0 3px rgba(229,62,62,0.35); }
.single-img-card { width: calc(100% - 10px); border-radius: 14px; overflow: hidden; background: #1e2a45; border: 2.5px solid rgba(255,255,255,0.1); margin: 0 auto 10px; flex-shrink: 0; transition: border-color 0.3s; }
.single-img-card img { width: 100%; display: block; object-fit: contain; background: #1e2a45; transition: filter 0.5s ease, transform 0.5s ease; }
.single-img-card.blurred img { filter: blur(10px); transform: scale(1.06); }
.single-img-card.revealed img { filter: blur(0); transform: scale(1); }
.single-img-card.revealed { border-color: #38a169; box-shadow: 0 0 0 3px rgba(56,161,105,0.25); }
@keyframes cardReveal { 0%{transform:scale(0.93);opacity:0.5;} 60%{transform:scale(1.04);} 100%{transform:scale(1);opacity:1;} }
.single-img-card.reveal-anim { animation: cardReveal 0.38s ease-out; }
.sentence-display { font-size: 15px; font-weight: 600; text-align: center; line-height: 1.7; margin-bottom: 10px; min-height: 48px; }
.blank { display: inline-block; background: rgba(255,255,255,0.1); border-bottom: 2px solid #BDA8D3; min-width: 80px; padding: 2px 8px; border-radius: 4px; }
.blank.filled-correct { color: #68d391; border-bottom-color: #38a169; background: rgba(56,161,105,0.15); }
.blank.filled-wrong   { color: #fc8181; border-bottom-color: #e53e3e; background: rgba(229,62,62,0.15); }
.word-options { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.word-opt-btn { background: rgba(255,255,255,0.08); border: 1.5px solid rgba(255,255,255,0.2); color: #fff; border-radius: 12px; padding: 9px 18px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.word-opt-btn:hover:not(:disabled) { background: rgba(255,255,255,0.15); border-color: #BDA8D3; }
.word-opt-btn.correct { background: rgba(56,161,105,0.25); border-color: #38a169; }
.word-opt-btn.wrong   { background: rgba(229,62,62,0.2); border-color: #e53e3e; }
.sentence-slots { display: flex; flex-wrap: wrap; gap: 7px; justify-content: center; min-height: 46px; padding: 10px; background: rgba(255,255,255,0.05); border-radius: 12px; width: 100%; margin-bottom: 10px; border: 1.5px dashed rgba(255,255,255,0.2); }
.placed-word { background: linear-gradient(135deg,#7B5EA7,#3C3489); color: #fff; border-radius: 8px; padding: 6px 13px; font-size: 13px; font-weight: 600; cursor: pointer; }
.word-bank { display: flex; flex-wrap: wrap; gap: 7px; justify-content: center; margin-bottom: 10px; }
.bank-word { background: rgba(255,255,255,0.08); border: 1.5px solid rgba(255,255,255,0.2); color: #fff; border-radius: 8px; padding: 6px 13px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.bank-word:hover { background: rgba(123,94,167,0.25); border-color: #7B5EA7; }
.bank-word.used { opacity: 0.3; pointer-events: none; }
.check-btn { background: linear-gradient(135deg,#38a169,#2f855a); border: none; color: #fff; border-radius: 12px; padding: 11px 30px; font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.2s; margin-top: 4px; }
.check-btn:hover:not(:disabled) { transform: scale(1.03); }
.check-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
@keyframes shake { 0%{transform:translateX(0);} 15%{transform:translateX(-8px);} 30%{transform:translateX(8px);} 45%{transform:translateX(-6px);} 60%{transform:translateX(6px);} 75%{transform:translateX(-4px);} 90%{transform:translateX(4px);} 100%{transform:translateX(0);} }
.shake { animation: shake 0.45s ease-in-out; }
.lc-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.72); z-index: 500; align-items: center; justify-content: center; }
.lc-overlay.show { display: flex; }
.lc-box { background: linear-gradient(135deg,#1e2a45,#16213e); border: 2px solid #7B5EA7; border-radius: 24px; padding: 36px 28px; text-align: center; max-width: 320px; width: 90%; }
.lc-emoji { font-size: 58px; margin-bottom: 10px; }
.lc-title { font-size: 22px; font-weight: 800; margin-bottom: 6px; }
.lc-sub   { font-size: 14px; color: #a0aec0; margin-bottom: 16px; }
.lc-score { font-size: 32px; font-weight: 800; color: #BDA8D3; margin-bottom: 20px; }
.lc-btn { background: linear-gradient(135deg,#7B5EA7,#3C3489); border: none; color: #fff; border-radius: 14px; padding: 13px 36px; font-size: 16px; font-weight: 700; cursor: pointer; width: 100%; transition: transform 0.15s; }
.lc-btn:hover { transform: scale(1.02); }
.feedback-toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-80px); background: #38a169; color: #fff; padding: 11px 22px; border-radius: 12px; font-weight: 700; font-size: 15px; transition: transform 0.3s; z-index: 999; pointer-events: none; }
.feedback-toast.show { transform: translateX(-50%) translateY(0); }
.feedback-toast.wrong-toast { background: #e53e3e; }
#result-screen { background: linear-gradient(135deg,#1a1a2e,#0f3460); justify-content: center; }
.result-emoji { font-size: 60px; margin-bottom: 10px; }
.result-title { font-size: 24px; font-weight: 800; margin-bottom: 6px; }
.result-sub   { font-size: 13px; color: #a0aec0; margin-bottom: 20px; text-align: center; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; width: 100%; margin-bottom: 20px; }
.stat-box { background: rgba(255,255,255,0.06); border-radius: 14px; padding: 12px 8px; text-align: center; }
.stat-num { font-size: 24px; font-weight: 800; color: #BDA8D3; }
.stat-lbl { font-size: 11px; color: #a0aec0; margin-top: 2px; }
.promo-block { width: 100%; background: rgba(255,255,255,0.05); border-radius: 16px; padding: 14px; margin-bottom: 16px; text-align: center; }
.promo-title { font-size: 12px; font-weight: 700; color: #a0aec0; margin-bottom: 10px; }
.promo-links { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.promo-link { background: rgba(255,255,255,0.08); color: #fff; text-decoration: none; border-radius: 10px; padding: 9px 10px; font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 5px; transition: background 0.2s; }
.promo-link:hover { background: rgba(255,255,255,0.15); }
.next-episode { font-size: 12px; color: #a0aec0; margin-bottom: 14px; text-align: center; }
.play-again-btn { background: linear-gradient(135deg,#7B5EA7,#3C3489); border: none; color: #fff; border-radius: 14px; padding: 13px 40px; font-size: 15px; font-weight: 700; cursor: pointer; width: 100%; margin-bottom: 10px; transition: transform 0.15s; }
.play-again-btn:hover { transform: scale(1.02); }
.home-link { font-size: 13px; color: #a0aec0; text-decoration: none; padding: 8px; }
.home-link:hover { color: #fff; }
audio { display: none; }
</style>
</head>
<body>
<div id="game-container">

<!-- HUB -->
<div id="hub-screen" class="screen active">
  <div class="hub-badge">POD-17</div>
  <div class="hub-title">Ancient Ruins</div>
  <div class="hub-subtitle">5 words · 3 levels</div>
  <div class="word-chips">
    <span class="word-chip" onclick="playAud('ancient_word')">ancient</span>
    <span class="word-chip" onclick="playAud('ruin_word')">ruin</span>
    <span class="word-chip" onclick="playAud('history_word')">history</span>
    <span class="word-chip" onclick="playAud('discover_word')">discover</span>
    <span class="word-chip" onclick="playAud('culture_word')">culture</span>
  </div>
  <div class="levels-title">Choose a Level</div>
  <div class="level-card" id="card-lv1" onclick="startLevel(1)">
    <div class="level-icon lv1">🔊</div>
    <div class="level-info"><div class="level-name">Level 1 · Word Match</div><div class="level-desc">Hear a word → pick the right picture</div></div>
    <span class="level-arrow">›</span>
  </div>
  <div class="level-card locked" id="card-lv2" onclick="startLevel(2)">
    <div class="level-icon lv2">✏️</div>
    <div class="level-info"><div class="level-name">Level 2 · Fill in the Blank</div><div class="level-desc">Hear a sentence → choose the missing word</div></div>
    <span class="level-arrow">›</span>
  </div>
  <div class="level-card locked" id="card-lv3" onclick="startLevel(3)">
    <div class="level-icon lv3">🔤</div>
    <div class="level-info"><div class="level-name">Level 3 · Sentence Builder</div><div class="level-desc">Hear a sentence → arrange the words</div></div>
    <span class="level-arrow">›</span>
  </div>
  <a href="https://easystoryenglish.github.io/ese-games/" class="home-link" style="margin-top:auto;padding-top:16px;">← Back to All Episodes</a>
</div>

<!-- LEVEL 1 -->
<div id="lv1-screen" class="screen">
  <div class="level-header">
    <button class="back-btn" onclick="goHub()">←</button>
    <div class="level-header-info">
      <div class="level-header-title">Level 1 · Word Match</div>
      <div class="level-header-sub">Tap ▶ then pick the picture</div>
    </div>
    <div class="score-badge" id="lv1-score">0 / 5</div>
  </div>
  <div class="progress-bar-wrap"><div class="progress-bar-fill" id="lv1-progress" style="width:0%"></div></div>
  <button class="play-word-btn" id="lv1-play-btn" onclick="lv1PlayWord()" style="background:linear-gradient(135deg,#7B5EA7,#3C3489)">▶</button>
  <div class="listen-label">Tap to hear the word</div>
  <div class="img-choices" id="lv1-choices"></div>
</div>

<!-- LEVEL 2 -->
<div id="lv2-screen" class="screen">
  <div class="level-header">
    <button class="back-btn" onclick="goHub()">←</button>
    <div class="level-header-info">
      <div class="level-header-title">Level 2 · Fill in the Blank</div>
      <div class="level-header-sub">Tap ▶ then choose the word</div>
    </div>
    <div class="score-badge" id="lv2-score">0 / 5</div>
  </div>
  <div class="progress-bar-wrap"><div class="progress-bar-fill" id="lv2-progress" style="width:0%"></div></div>
  <div class="single-img-card blurred" id="lv2-card"><img id="lv2-card-img" src="" alt=""></div>
  <button class="play-word-btn" id="lv2-play-btn" onclick="lv2PlaySentence()" style="background:linear-gradient(135deg,#9B77C7,#5C4499)">▶</button>
  <div class="listen-label">Tap to hear the sentence</div>
  <div class="sentence-display" id="lv2-sentence"></div>
  <div class="word-options" id="lv2-options"></div>
</div>

<!-- LEVEL 3 -->
<div id="lv3-screen" class="screen">
  <div class="level-header">
    <button class="back-btn" onclick="goHub()">←</button>
    <div class="level-header-info">
      <div class="level-header-title">Level 3 · Sentence Builder</div>
      <div class="level-header-sub">Tap ▶ then arrange the words</div>
    </div>
    <div class="score-badge" id="lv3-score">0 / 5</div>
  </div>
  <div class="progress-bar-wrap"><div class="progress-bar-fill" id="lv3-progress" style="width:0%"></div></div>
  <div class="single-img-card blurred" id="lv3-card"><img id="lv3-card-img" src="" alt=""></div>
  <button class="play-word-btn" id="lv3-play-btn" onclick="lv3PlaySentence()" style="background:linear-gradient(135deg,#BDA8D3,#7B5EA7)">▶</button>
  <div class="listen-label">Tap to hear the sentence</div>
  <div class="sentence-slots" id="lv3-slots"><span style="color:#666;font-size:12px">Your sentence appears here</span></div>
  <div class="word-bank" id="lv3-bank"></div>
  <button class="check-btn" id="lv3-check" onclick="lv3Check()" disabled>Check ✓</button>
</div>

<!-- RESULT -->
<div id="result-screen" class="screen">
  <div class="result-emoji" id="result-emoji">🎉</div>
  <div class="result-title" id="result-title">Amazing!</div>
  <div class="result-sub">You completed all 3 levels of POD-17!</div>
  <div class="stats-grid">
    <div class="stat-box"><div class="stat-num" id="stat-correct">-</div><div class="stat-lbl">Correct</div></div>
    <div class="stat-box"><div class="stat-num" id="stat-accuracy">-</div><div class="stat-lbl">Accuracy</div></div>
    <div class="stat-box"><div class="stat-num" id="stat-stars">-</div><div class="stat-lbl">Rating</div></div>
  </div>
  <div class="promo-block">
    <div class="promo-title">🎧 Keep learning with Easy Story English</div>
    <div class="promo-links">
      <a class="promo-link" href="https://open.spotify.com/show/4rnqN6pvaScLTI4RpvOiC1" target="_blank">🎵 Spotify</a>
      <a class="promo-link" href="https://youtube.com/@EasyStoryENG" target="_blank">▶ YouTube</a>
      <a class="promo-link" href="https://podcasts.apple.com/podcast/id1896817184" target="_blank">🍎 Apple Podcasts</a>
      <a class="promo-link" href="https://castbox.fm/channel/Easy-Story-English-Podcast-id7244314" target="_blank">📦 Castbox</a>
    </div>
  </div>
  <div class="next-episode">Ready for more? Try another episode!</div>
  <button class="play-again-btn" onclick="resetAll()">Play Again 🔄</button>
  <a href="https://easystoryenglish.github.io/ese-games/" class="home-link">← Back to All Episodes</a>
</div>

<!-- LEVEL COMPLETE OVERLAY -->
<div class="lc-overlay" id="lc-overlay">
  <div class="lc-box">
    <div class="lc-emoji" id="lc-emoji">🎉</div>
    <div class="lc-title" id="lc-title">Level Complete!</div>
    <div class="lc-sub" id="lc-sub">Great effort!</div>
    <div class="lc-score" id="lc-score">5 / 5</div>
    <button class="lc-btn" onclick="lcContinue()">Continue →</button>
  </div>
</div>

<div class="feedback-toast" id="toast"></div>
<!-- AUDIO -->
<audio id="aud-ancient_word" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-ancient_sent" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-ruin_word" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-ruin_sent" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-history_word" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-history_sent" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-discover_word" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-discover_sent" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-culture_word" src="data:audio/mpeg;base64,"></audio>
<audio id="aud-culture_sent" src="data:audio/mpeg;base64,"></audio>

<script>
const IMGS = {
  ancient: 'data:image/jpeg;base64,',
  ruin: 'data:image/jpeg;base64,',
  history: 'data:image/jpeg;base64,',
  discover: 'data:image/jpeg;base64,',
  culture: 'data:image/jpeg;base64,',
};

const VOCAB = [
  {
    key: 'ancient', word: 'ancient',
    audWord: 'ancient_word', audSentence: 'ancient_sent',
    blankSentence: ['This', 'is', 'an', '___', 'building'],
    blankAnswer: 'ancient', blankDistractors: ['ruins', 'history', 'culture']
    , fullWords: ['This', 'is', 'an', 'ancient', 'building']
  },
  {
    key: 'ruin', word: 'ruin',
    audWord: 'ruin_word', audSentence: 'ruin_sent',
    blankSentence: ['The', '___', 'are', 'very', 'beautiful'],
    blankAnswer: 'ruins', blankDistractors: ['ancient', 'history', 'discover'],
    fullWords: ['The', 'ruins', 'are', 'very', 'beautiful']
  },
  {
    key: 'history', word: 'history',
    audWord: 'history_word', audSentence: 'history_sent',
    blankSentence: ['I', 'love', 'learning', 'about', '___'],
    blankAnswer: 'history', blankDistractors: ['ancient', 'ruins', 'discover'],
    fullWords: ['I', 'love', 'learning', 'about', 'history']
  },
  {
    key: 'discover', word: 'discover',
    audWord: 'discover_word', audSentence: 'discover_sent',
    blankSentence: ['Let\'s', '___', 'Algeria', 'together'],
    blankAnswer: 'discover', blankDistractors: ['history', 'culture', 'ruins'],
    fullWords: ['Let\'s', 'discover', 'Algeria', 'together']
  },
  {
    key: 'culture', word: 'culture',
    audWord: 'culture_word', audSentence: 'culture_sent',
    blankSentence: ['I', 'want', 'to', 'learn', 'about', 'Algerian', '___'],
    blankAnswer: 'culture', blankDistractors: ['ancient', 'discover', 'history'],
    fullWords: ['I', 'want', 'to', 'learn', 'about', 'Algerian', 'culture']
  },
];

let levelsUnlocked=[true,false,false],levelScores=[0,0,0],levelCompleted=[false,false,false];
let totalCorrect=0,totalAttempts=0,toastTimer,lcNextAction=null;

function shuffle(arr){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function playAud(key){const el=document.getElementById('aud-'+key);if(el){el.currentTime=0;el.play().catch(()=>{});}}
function showToast(m,g){const t=document.getElementById('toast');t.textContent=m;t.className='feedback-toast show'+(g?'':' wrong-toast');clearTimeout(toastTimer);toastTimer=setTimeout(()=>{t.className='feedback-toast';},1500);}
function shakeEl(el){el.classList.remove('shake');void el.offsetWidth;el.classList.add('shake');el.addEventListener('animationend',()=>el.classList.remove('shake'),{once:true});}
function setCardImg(p,v){document.getElementById(p+'-card-img').src=IMGS[v.key];}
function blurCard(p){const c=document.getElementById(p+'-card');c.classList.remove('revealed','reveal-anim');c.classList.add('blurred');}
function revealCard(p){const c=document.getElementById(p+'-card');c.classList.remove('blurred');c.classList.add('revealed','reveal-anim');c.addEventListener('animationend',()=>c.classList.remove('reveal-anim'),{once:true});}
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}
function goHub(){document.getElementById('lc-overlay').classList.remove('show');showScreen('hub-screen');updateHubCards();}
function updateHubCards(){
  ['card-lv1','card-lv2','card-lv3'].forEach((id,i)=>{
    const card=document.getElementById(id);card.classList.remove('locked','completed');
    const lock=card.querySelector('.lock-icon');if(lock)lock.remove();
    if(!levelsUnlocked[i]){card.classList.add('locked');const l=document.createElement('span');l.className='lock-icon';l.textContent='🔒';card.appendChild(l);}
    else if(levelCompleted[i])card.classList.add('completed');
  });
}
function startLevel(n){if(!levelsUnlocked[n-1]){showToast('Complete Level '+(n-1)+' first!',false);return;}if(n===1)initLv1();else if(n===2)initLv2();else initLv3();}
function showLevelComplete(lv,score,total,fn){
  sfxLevelComplete();lcNextAction=fn;
  const e=score===total?'🎉':score>=total*0.6?'👍':'💪';
  document.getElementById('lc-emoji').textContent=e;
  document.getElementById('lc-title').textContent='Level '+lv+' Complete!';
  document.getElementById('lc-sub').textContent=score===total?'Perfect score! Amazing!':score>=total*0.6?'Great effort!':'Keep practising!';
  document.getElementById('lc-score').textContent=score+' / '+total;
  document.getElementById('lc-overlay').classList.add('show');
}
function lcContinue(){document.getElementById('lc-overlay').classList.remove('show');if(lcNextAction)lcNextAction();}

const AudioCtx=window.AudioContext||window.webkitAudioContext;let _actx=null;
function getACtx(){if(!_actx)_actx=new AudioCtx();return _actx;}
function sfxCorrect(){try{const ctx=getACtx(),t=ctx.currentTime;[523.25,659.25,783.99].forEach((freq,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.type='sine';o.frequency.value=freq;const st=t+i*0.12;g.gain.setValueAtTime(0,st);g.gain.linearRampToValueAtTime(0.25,st+0.02);g.gain.exponentialRampToValueAtTime(0.001,st+0.25);o.start(st);o.stop(st+0.3);});}catch(e){}}
function sfxWrong(){try{const ctx=getACtx(),t=ctx.currentTime;[220,185].forEach((freq,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.type='sawtooth';o.frequency.value=freq;const st=t+i*0.15;g.gain.setValueAtTime(0,st);g.gain.linearRampToValueAtTime(0.2,st+0.02);g.gain.exponentialRampToValueAtTime(0.001,st+0.28);o.start(st);o.stop(st+0.32);});}catch(e){}}
function sfxLevelComplete(){try{const ctx=getACtx(),t=ctx.currentTime;[523.25,659.25,783.99,1046.5,1318.5].forEach((freq,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.type='sine';o.frequency.value=freq;const st=t+i*0.1;g.gain.setValueAtTime(0,st);g.gain.linearRampToValueAtTime(0.22,st+0.03);g.gain.exponentialRampToValueAtTime(0.001,st+0.5);o.start(st);o.stop(st+0.55);});}catch(e){}}

let lv1Queue,lv1Idx,lv1Score,lv1Current,lv1Can=false,lv1Trans=false;
function initLv1(){lv1Queue=shuffle([...VOCAB]);lv1Idx=0;lv1Score=0;lv1Can=false;lv1Trans=false;document.getElementById('lv1-score').textContent='0 / 5';document.getElementById('lv1-progress').style.width='0%';showScreen('lv1-screen');lv1Q();}
function lv1Q(){
  if(lv1Idx>=lv1Queue.length){lv1Fin();return;}
  lv1Current=lv1Queue[lv1Idx];lv1Can=false;lv1Trans=false;
  const d=shuffle(VOCAB.filter(v=>v.key!==lv1Current.key)).slice(0,3);
  const ch=shuffle([lv1Current,...d]);
  const el=document.getElementById('lv1-choices');el.innerHTML='';
  ch.forEach(v=>{const c=document.createElement('div');c.className='img-choice-card';const img=document.createElement('img');img.src=IMGS[v.key];img.alt=v.word;c.appendChild(img);c.addEventListener('click',()=>lv1Ans(c,v.key===lv1Current.key));el.appendChild(c);});
  document.getElementById('lv1-play-btn').disabled=false;
}
function lv1PlayWord(){if(lv1Trans)return;playAud(lv1Current.audWord);lv1Can=true;}
function lv1Ans(card,ok){
  if(!lv1Can){showToast('Tap ▶ first!',false);return;}
  lv1Can=false;lv1Trans=true;document.getElementById('lv1-play-btn').disabled=true;totalAttempts++;
  if(ok){card.classList.add('correct');lv1Score++;totalCorrect++;sfxCorrect();showToast('Correct! ✓',true);}
  else{card.classList.add('wrong');sfxWrong();shakeEl(card);showToast('Try again!',false);}
  lv1Idx++;document.getElementById('lv1-score').textContent=lv1Score+' / 5';document.getElementById('lv1-progress').style.width=(lv1Idx/5*100)+'%';
  setTimeout(()=>{lv1Trans=false;lv1Q();},950);
}
function lv1Fin(){levelScores[0]=lv1Score;levelCompleted[0]=true;levelsUnlocked[1]=true;updateHubCards();showLevelComplete(1,lv1Score,5,()=>{if(levelCompleted[1]&&levelCompleted[2])showResult();else goHub();});}

let lv2Queue,lv2Idx,lv2Score,lv2Current,lv2Can=false,lv2Trans=false;
function initLv2(){lv2Queue=shuffle([...VOCAB]);lv2Idx=0;lv2Score=0;lv2Can=false;lv2Trans=false;document.getElementById('lv2-score').textContent='0 / 5';document.getElementById('lv2-progress').style.width='0%';showScreen('lv2-screen');lv2Q();}
function lv2Q(){
  if(lv2Idx>=lv2Queue.length){lv2Fin();return;}
  lv2Current=lv2Queue[lv2Idx];lv2Can=false;lv2Trans=false;
  setCardImg('lv2',lv2Current);blurCard('lv2');
  const parts=lv2Current.blankSentence.map(w=>w==='___'?'<span class="blank" id="lv2-blank">___</span>':w);
  document.getElementById('lv2-sentence').innerHTML=parts.join(' ');
  const opts=shuffle([lv2Current.blankAnswer,...lv2Current.blankDistractors.slice(0,3)]);
  const el=document.getElementById('lv2-options');el.innerHTML='';
  opts.forEach(word=>{
    const btn=document.createElement('button');btn.className='word-opt-btn';btn.textContent=word;
    btn.addEventListener('click',()=>lv2Ans(btn,word===lv2Current.blankAnswer,word));
    el.appendChild(btn);
  });
  document.getElementById('lv2-play-btn').disabled=false;
}
function lv2PlaySentence(){if(lv2Trans)return;playAud(lv2Current.audSentence);lv2Can=true;}
function lv2Ans(btn,ok,word){
  if(!lv2Can){showToast('Tap ▶ first!',false);return;}
  lv2Can=false;lv2Trans=true;document.getElementById('lv2-play-btn').disabled=true;
  document.querySelectorAll('#lv2-options .word-opt-btn').forEach(b=>b.disabled=true);
  totalAttempts++;const blank=document.getElementById('lv2-blank');
  if(ok){btn.classList.add('correct');if(blank){blank.textContent=word;blank.classList.add('filled-correct');}lv2Score++;totalCorrect++;sfxCorrect();showToast('Correct! ✓',true);revealCard('lv2');}
  else{btn.classList.add('wrong');if(blank)blank.classList.add('filled-wrong');sfxWrong();shakeEl(btn);showToast('Not quite!',false);}
  lv2Idx++;document.getElementById('lv2-score').textContent=lv2Score+' / 5';document.getElementById('lv2-progress').style.width=(lv2Idx/5*100)+'%';
  setTimeout(()=>{lv2Trans=false;lv2Q();},ok?1600:950);
}
function lv2Fin(){levelScores[1]=lv2Score;levelCompleted[1]=true;levelsUnlocked[2]=true;updateHubCards();showLevelComplete(2,lv2Score,5,()=>{if(levelCompleted[0]&&levelCompleted[2])showResult();else goHub();});}

let lv3Queue,lv3Idx,lv3Score,lv3Current,lv3Placed,lv3Can=false,lv3Trans=false;
function initLv3(){lv3Queue=shuffle([...VOCAB]);lv3Idx=0;lv3Score=0;lv3Can=false;lv3Trans=false;document.getElementById('lv3-score').textContent='0 / 5';document.getElementById('lv3-progress').style.width='0%';showScreen('lv3-screen');lv3Q();}
function lv3Q(){
  if(lv3Idx>=lv3Queue.length){lv3Fin();return;}
  lv3Current=lv3Queue[lv3Idx];lv3Placed=[];lv3Can=false;lv3Trans=false;
  setCardImg('lv3',lv3Current);blurCard('lv3');
  const sw=shuffle([...lv3Current.fullWords]);
  document.getElementById('lv3-slots').innerHTML='<span style="color:#666;font-size:12px">Your sentence appears here</span>';
  const bank=document.getElementById('lv3-bank');bank.innerHTML='';
  sw.forEach((w,i)=>{const btn=document.createElement('button');btn.className='bank-word';btn.textContent=w;btn.dataset.idx=i;btn.addEventListener('click',()=>lv3Place(btn,w,String(i)));bank.appendChild(btn);});
  document.getElementById('lv3-check').disabled=true;document.getElementById('lv3-play-btn').disabled=false;
}
function lv3PlaySentence(){if(lv3Trans)return;playAud(lv3Current.audSentence);lv3Can=true;}
function lv3Place(btn,word,idx){
  const entry=word+'||'+idx,pos=lv3Placed.indexOf(entry);
  if(pos!==-1){lv3Placed.splice(pos,1);btn.classList.remove('used');}else{lv3Placed.push(entry);btn.classList.add('used');}
  lv3UpdateSlots();
}
function lv3UpdateSlots(){
  const slots=document.getElementById('lv3-slots');
  if(lv3Placed.length===0){slots.innerHTML='<span style="color:#666;font-size:12px">Your sentence appears here</span>';document.getElementById('lv3-check').disabled=true;return;}
  slots.innerHTML='';
  lv3Placed.forEach(entry=>{
    const word=entry.split('||')[0],idx=entry.split('||')[1];
    const div=document.createElement('div');div.className='placed-word';div.textContent=word;
    div.addEventListener('click',()=>{const pos=lv3Placed.indexOf(entry);if(pos!==-1)lv3Placed.splice(pos,1);document.querySelectorAll('.bank-word').forEach(b=>{if(b.dataset.idx===idx)b.classList.remove('used');});lv3UpdateSlots();});
    slots.appendChild(div);
  });
  document.getElementById('lv3-check').disabled=lv3Placed.length!==lv3Current.fullWords.length;
}
function lv3Check(){
  if(!lv3Can){showToast('Tap ▶ first!',false);return;}if(lv3Trans)return;
  lv3Can=false;lv3Trans=true;document.getElementById('lv3-play-btn').disabled=true;document.getElementById('lv3-check').disabled=true;
  const answer=lv3Placed.map(e=>e.split('||')[0]).join(' '),correct=lv3Current.fullWords.join(' ');
  totalAttempts++;const ok=answer===correct;
  if(ok){lv3Score++;totalCorrect++;sfxCorrect();showToast('Perfect! ✓',true);revealCard('lv3');}
  else{sfxWrong();shakeEl(document.getElementById('lv3-slots'));showToast('The sentence: '+correct,false);}
  lv3Idx++;document.getElementById('lv3-score').textContent=lv3Score+' / 5';document.getElementById('lv3-progress').style.width=(lv3Idx/5*100)+'%';
  setTimeout(()=>{lv3Trans=false;lv3Q();},ok?1600:1200);
}
function lv3Fin(){levelScores[2]=lv3Score;levelCompleted[2]=true;updateHubCards();showLevelComplete(3,lv3Score,5,()=>{if(levelCompleted[0]&&levelCompleted[1])showResult();else goHub();});}

function showResult(){
  const total=15,acc=totalAttempts>0?Math.round(totalCorrect/totalAttempts*100):0;
  const stars=acc>=90?'⭐⭐⭐':acc>=60?'⭐⭐':'⭐';
  document.getElementById('stat-correct').textContent=totalCorrect+'/'+total;
  document.getElementById('stat-accuracy').textContent=acc+'%';
  document.getElementById('stat-stars').textContent=stars;
  document.getElementById('result-emoji').textContent=acc>=90?'🎉':acc>=60?'👍':'💪';
  document.getElementById('result-title').textContent=acc>=90?'Amazing!':acc>=60?'Good job!':'Keep going!';
  showScreen('result-screen');sfxLevelComplete();
  if(typeof gtag!=='undefined')gtag('event','pod17_complete',{accuracy:acc,correct:totalCorrect});
}
function resetAll(){levelsUnlocked=[true,false,false];levelScores=[0,0,0];levelCompleted=[false,false,false];totalCorrect=0;totalAttempts=0;updateHubCards();goHub();}
updateHubCards();
</script>
</div>
</body>
</html>
